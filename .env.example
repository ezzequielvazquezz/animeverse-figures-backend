# --- Servidor ---
PORT=3000
NODE_ENV=development
# Orígenes permitidos (separados por coma). En producción: la URL de Vercel.
CORS_ORIGIN=http://localhost:5173

# --- Base de datos (MySQL / Aiven) ---
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=animeverse_figures
# true en Aiven (conexión cifrada)
DB_SSL=false
# Opcional: contenido PEM del certificado CA de Aiven (saltos de línea como \n).
# Si se define, se valida el certificado del servidor; si no, solo se cifra la conexión.
DB_SSL_CA=

# --- Autenticación del panel de administración ---
# Genera uno largo y aleatorio:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=8h

# Solo los usa `npm run crear-admin` (puedes pasarlos al ejecutar el comando sin guardarlos aquí)
ADMIN_NOMBRE=
ADMIN_EMAIL=
ADMIN_PASSWORD=
